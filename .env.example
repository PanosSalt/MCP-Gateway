POSTGRES_PASSWORD=mcppass
# DATABASE_URL is used when running outside Docker (e.g. local dev).
# In Docker, docker-compose.yml builds it from POSTGRES_PASSWORD above.
DATABASE_URL=postgresql://mcpuser:mcppass@localhost:5432/mcpgateway

# ── Required secrets ──────────────────────────────────────────────────────────
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production
# Must be at least 32 characters. Full value is consumed via BLAKE2b derivation.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=change-this-32-byte-key-in-prod!!

# ── Application URL ───────────────────────────────────────────────────────────
BASE_URL=http://localhost:8000

# ── AI / LLM ─────────────────────────────────────────────────────────────────
# Only required for the REST POST /query/ endpoint.
# When using Claude Desktop via MCP, Claude itself handles SQL generation
# and result interpretation — no API key needed in the gateway.
# ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Must be absolute URLs — wildcards
# are rejected. Defaults to BASE_URL when unset.
# CORS_ORIGINS=https://admin.example.com,https://gateway.example.com

# ── OAuth TTLs (seconds expressed as minutes) ─────────────────────────────────
# Increase in high-latency environments (slow SSO providers, mobile networks).
# OAUTH_STATE_TTL_MINUTES=10
# OAUTH_CODE_TTL_MINUTES=5

# ── Filesystem tools ──────────────────────────────────────────────────────────
# Comma-separated directories the MCP filesystem tools may access.
# When empty (default), no filesystem tools are exposed.
# In Docker, mount host directories as volumes and list the container paths here.
# FILESYSTEM_ALLOWED_DIRS=/data,/projects

# ── Logging ──────────────────────────────────────────────────────────────────
# LOG_LEVEL=INFO
